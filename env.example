# Create a '.env' file with this configuration

APP_ENVIRONMENT=development # development, staging, production, etc

# Database Configuration
DB_URL=jdbc:h2:mem:testdb # in production, this should be the database URL
DB_USERNAME=sa
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Email Configuration (AWS SES)
SPRING_MAIL_HOST=email-smtp.us-east-1.amazonaws.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=your-ses-username
SPRING_MAIL_PASSWORD=your-ses-password
SPRING_MAIL_FROM_EMAIL=noreply@yourdomain.com
SPRING_MAIL_FROM_NAME=AuthKit

# Frontend URL
FRONTEND_URL=http://localhost:3000

# WebAuthn Configuration (Passkeys)
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=AuthKit
WEBAUTHN_RP_ORIGIN=http://localhost:3000

# Admin User Configuration (optional)
# Set these to automatically create an admin user on startup
ADMIN_USER=admin
ADMIN_PASSWORD=Admin123!
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Admin
ADMIN_SURNAME=User
